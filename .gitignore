.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.coverage
coverage.xml

# Environment & Secrets
.env
.env.local
*.env

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Runtime-generated: Price Data Cache ──────────────────────────────────────
# Downloaded OHLCV CSV files fetched from Yahoo Finance at runtime
data/market/*.csv

# ── Runtime-generated: Timestamped Market Reports ────────────────────────────
# Per-run analysis TXT files (e.g. HDFCBANK_NS_20260724T101647Z.txt)
reports/market/*.txt

# Keep permanent report artefacts
!reports/market/.gitkeep
!reports/market/all_trades.md
!reports/market/closed_trades.md
!reports/market/snapshot.json

# ── Runtime-generated: Signal State ──────────────────────────────────────────
# Per-symbol JSON signal state written by the scheduler
state/*.json

# ── Runtime-generated: Web / GitHub Pages pre-computed data ──────────────────
# Symbol JSON files generated by generate_web_data.py
web/data/*.json
docs/data/*.json

# High-conviction signals tracker (runtime-appended)
pie/reporting/high_score_signals.json

# ── Scratch / Temp ────────────────────────────────────────────────────────────
scratch/
tmp/
*.log
